{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vajra-ai.dev/contracts/task.schema.json",
  "title": "Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "created_at", "updated_at", "status", "description"],
  "properties": {
    "task_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["pending", "running", "blocked", "completed", "failed"] },
    "description": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "description": "Task-scoped constraints evaluated by policy engine",
      "additionalProperties": false,
      "properties": {
        "allowed_tools": {
          "type": "array", "items": { "type": "string" }, "uniqueItems": true,
          "description": "Tools this task is permitted to request"
        },
        "resources": {
          "type": "array", "items": { "type": "string" }, "uniqueItems": true,
          "description": "Resources this task may access"
        },
        "destination_allowlist": {
          "type": "array", "items": { "type": "string" }, "uniqueItems": true,
          "description": "Allowed external destinations"
        },
        "block_external_destinations": {
          "type": "boolean",
          "description": "If true, block destinations not in allowlist"
        }
      }
    }
  }
}
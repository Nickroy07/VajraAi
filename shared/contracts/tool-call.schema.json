{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vajra-ai.dev/contracts/tool-call.schema.json",
  "title": "Tool Call Proposal / Gateway Execution",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "agent_id", "tool_name"],
  "properties": {
    "task_id": { "type": "string", "format": "uuid", "description": "Task requesting execution" },
    "agent_id": { "type": "string", "format": "uuid", "description": "Agent making the request" },
    "tool_name": { "type": "string", "minLength": 1, "description": "Tool to execute" },
    "arguments": { "type": "object", "description": "Tool arguments" },
    "resource": { "type": "string", "description": "Target resource" },
    "destination": { "type": "string", "description": "Target destination (e.g. email address)" },
    "approval_id": { "type": "string", "format": "uuid", "description": "Pre-approved approval ID, if required" }
  }
}